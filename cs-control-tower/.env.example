# =============================================================================
# cs-control-tower environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# Downstream Spring Boot service URLs
CRM_URL=http://localhost:8081
VENDOR_URL=http://localhost:8082
PROCUREMENT_URL=http://localhost:8083
WMS_INBOUND_URL=http://localhost:8084
OMS_URL=http://localhost:8085
WMS_OUTBOUND_URL=http://localhost:8086
TMS_URL=http://localhost:8087

# SQLite BI database (no extra setup needed)
DATABASE_URL=sqlite:///control_tower_bi.db
