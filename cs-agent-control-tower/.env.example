# Anthropic
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# Flask
FLASK_SECRET_KEY=dev-secret-change-in-prod
FLASK_PORT=9000
FLASK_DEBUG=true

# SQLite checkpoint path
CHECKPOINT_DB_PATH=./agent_checkpoints.db

# Audit / observability
AUDIT_DB_PATH=./audit.db
AUDIT_LOG_DIR=./logs
AUDIT_LOG_RETENTION_DAYS=90

# Keycloak — shared base URL/realm for both clients below
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=scm-poc

# Keycloak — machine-to-machine client this app uses to call the 7 SCM
# services (CRM/Vendor/Procurement/WMS/OMS/TMS). Needs a CONFIDENTIAL
# client in Keycloak admin with "Service accounts enabled" turned on.
KEYCLOAK_SERVICE_CLIENT_ID=cs-agent-control-tower-service
KEYCLOAK_SERVICE_CLIENT_SECRET=CHANGE_ME

# Keycloak — user-facing SSO login (the "Login" button). Needs a
# CONFIDENTIAL client with "Standard flow enabled" (Authorization Code)
# and a Valid Redirect URI of http://localhost:9000/auth/callback
# (adjust host/port to match FLASK_PORT above).
KEYCLOAK_APP_CLIENT_ID=cs-agent-control-tower-web
KEYCLOAK_APP_CLIENT_SECRET=CHANGE_ME
