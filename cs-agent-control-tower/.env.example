# Anthropic
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# Flask
FLASK_SECRET_KEY=dev-secret-change-in-prod
FLASK_PORT=9000
FLASK_DEBUG=true

# SQLite checkpoint path
CHECKPOINT_DB_PATH=./agent_checkpoints.db
