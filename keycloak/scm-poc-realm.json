        "http://localhost:8090"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8090/",
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
